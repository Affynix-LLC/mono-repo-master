{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "https://api.affynix.ai"
  },
  "passwordProtection": {
    "enabled": true,
    "note": "Set ADMIN_GATE_PASSWORD environment variable in Vercel dashboard for password protection"
  }
}
