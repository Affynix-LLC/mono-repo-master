# Agent Configuration
# Default prompt ID to use when none is specified in conversation metadata
# Available prompts are defined in lib/promptRegistry.js
AFFYNIX_AGENT_PROMPT_ID=pmpt_697698bb3df08195b295e1a4009cbfab0a9b742494ff272d

# Webhooks (optional)
ZAPIER_AGENT_WEBHOOK_URL=
