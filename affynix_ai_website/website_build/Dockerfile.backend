# Backend API server
FROM node:20-alpine

WORKDIR /app

# Install build dependencies for native modules (better-sqlite3)
RUN apk add --no-cache \
    curl \
    python3 \
    make \
    g++ \
    sqlite

# Copy package files
COPY backend/package.json ./

# Install dependencies
RUN npm install

# Copy backend source
COPY backend/ ./

# Create data directory for database
RUN mkdir -p /app/data

# Expose port
EXPOSE 3001

# Start server
CMD ["npm", "start"]

