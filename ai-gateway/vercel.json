{
  "version": 2,
  "builds": [
    {
      "src": "app/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/app/api/$1/route.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/app/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_DOMAIN": "ai.affynix.ai"
  }
}

